<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="TrainerMaster.master.cs"
    Inherits="Training.Trainer.TrainerMaster" %>

<!DOCTYPE html>

<html>

<head runat="server">

    <title>Trainer Portal</title>

    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="keywords" />
    <meta content="" name="description" />

    <!-- Favicon -->
    <link href='<%= ResolveUrl("~/img/BSPHCL_Logo.jpg") %>' rel="icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Handlee&family=Nunito:wght@400;600;700&display=swap"
        rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css"
        rel="stylesheet" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <link href='<%= ResolveUrl("~/css/style.css") %>'
        rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nunito',sans-serif;
            background: #f5f7fb;
        }

        /* =========================
           TOP HEADER
        ========================= */

        .top-header {
            height: 75px;
            background: #fff;
            border-bottom: 1px solid #dcdcdc;
            display: flex;
            align-items: center;
            padding: 0 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            position: sticky;
            top: 0;
            z-index: 9999;
            justify-content: space-between;
        }

        .header-logo {
            height: 55px;
            width: auto;
            margin-right: 15px;
        }

        .header-title {
            font-size: 30px;
            font-weight: 700;
            color: #0d6efd;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .notification {
            position: relative;
            font-size: 24px;
            color: #555;
            cursor: pointer;
        }

            .notification:hover {
                color: #0d6efd;
            }

        .notify-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background: red;
            color: white;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            font-size: 11px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .user-info i {
                font-size: 38px;
                color: #0d6efd;
            }

        .user-name {
            font-size: 16px;
            font-weight: bold;
        }

        .date-time {
            font-size: 12px;
            color: #666;
        }

        /* =========================
           MAIN LAYOUT
        ========================= */

        .main-layout {
            display: flex;
            min-height: calc(100vh - 75px);
        }

        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            width: 260px;
            background: #1f2937;
            color: #fff;
            flex-shrink: 0;
            position: sticky;
            top: 75px;
            height: calc(100vh - 75px);
            overflow-y: auto;
            transition: all .3s ease;
        }

            .sidebar.collapsed {
                width: 0;
                min-width: 0;
                overflow: hidden;
            }

            .sidebar::-webkit-scrollbar {
                width: 8px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: #4b5563;
                border-radius: 20px;
            }

        .menu-heading {
            background: #111827;
            color: #ffd54f;
            font-size: 15px;
            font-weight: 700;
            padding: 14px 18px;
            border-top: 1px solid #374151;
            border-bottom: 1px solid #374151;
            cursor: pointer;
            position: relative;
            transition: .3s;
        }

            .menu-heading:hover {
                background: #1e293b;
            }

            .menu-heading:after {
                content: '▼';
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 12px;
            }

            .menu-heading.collapsed:after {
                content: '▶';
            }

        .submenu-container {
            display: block;
        }

            .submenu-container.hide {
                display: none;
            }

        .menu-item,
        .submenu-item {
            display: block;
            color: #fff;
            text-decoration: none;
            padding: 12px 18px;
            border-bottom: 1px solid #374151;
            transition: .3s;
        }

        .submenu-item {
            padding-left: 35px;
            background: #273449;
        }

            .menu-item:hover,
            .submenu-item:hover {
                background: #2563eb;
                color: #fff;
                text-decoration: none;
            }

        .active-menu {
            background: #2563eb !important;
            color: #fff !important;
            font-weight: 700;
            border-left: 4px solid #ffd54f;
        }

        .logout-btn {
            background: #dc2626;
            font-weight: 700;
        }

            .logout-btn:hover {
                background: #b91c1c;
            }

        /* =========================
           CONTENT AREA
        ========================= */

        .content-area {
            flex: 1;
            min-width: 0;
            padding: 20px;
            overflow-x: auto;
            background: #f8fafc;
            transition: all .3s ease;
        }

        .toggle-btn {
            font-size: 28px;
            color: #0d6efd;
            cursor: pointer;
            margin-right: 18px;
            user-select: none;
        }

            .toggle-btn:hover {
                color: #ff9800;
            }

        /* =========================
           FOOTER
        ========================= */

        .footer {
            background: #382621;
            color: white;
            padding: 20px 0;
            text-align: center;
        }

            .footer img {
                height: 50px;
                margin: 0 10px;
            }

        .footer-text {
            color: #4fc3f7;
            font-weight: bold;
        }

        /* =========================
           MOBILE
        ========================= */

        @media(max-width:900px) {

            .top-header {
                height: auto;
                min-height: 65px;
                padding: 8px 10px;
                flex-wrap: wrap;
                gap: 8px;
            }

                .top-header > div:first-child {
                    flex: 1;
                    min-width: 0;
                }

            .toggle-btn {
                font-size: 24px;
                margin-right: 10px;
            }

            .header-logo {
                height: 38px;
                margin-right: 8px;
            }

            .header-title {
                font-size: 15px;
                line-height: 18px;
            }

            .header-right {
                gap: 12px;
                margin-left: auto;
            }

            .notification {
                font-size: 20px;
            }

            .user-info {
                gap: 6px;
            }

                .user-info i {
                    font-size: 28px;
                }

            .user-name {
                font-size: 13px;
            }

            .date-time {
                font-size: 10px;
            }

            .main-layout {
                flex-direction: column;
                min-height: auto;
            }

            .sidebar {
                width: 100%;
                height: auto;
                max-height: none;
                position: relative;
                top: 0;
            }

                .sidebar.collapsed {
                    display: none;
                    width: 100%;
                }

            .content-area {
                width: 100%;
                padding: 10px;
                overflow-x: auto;
            }

            .menu-heading,
            .menu-item,
            .submenu-item {
                font-size: 14px;
            }
        }


        @media(max-width:576px) {

            .top-header {
                align-items: center;
            }

            .header-title {
                font-size: 13px;
            }

            .header-logo {
                height: 34px;
            }

            .header-right {
                width: 100%;
                justify-content: flex-end;
                border-top: 1px solid #eee;
                padding-top: 5px;
            }

            .user-info i {
                font-size: 25px;
            }

            .content-area {
                padding: 7px;
            }

            .submenu-item {
                padding-left: 28px;
            }

            .sidebar .submenu-container .menu-heading {
                padding-left: 28px;
            }

            .sidebar .submenu-container .submenu-container .submenu-item {
                padding-left: 45px;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

    <form id="form1" runat="server">

        <!-- =========================
             TOP HEADER
        ========================== -->

        <div class="top-header">

            <div style="display: flex; align-items: center;">

                <span class="toggle-btn" onclick="toggleSidebar()">&#9776;</span>

                <img src='<%= ResolveUrl("~/img/BSPHCL_Logo.jpg") %>' class="header-logo" />

                <span class="header-title">Trainer Portal - BSPHCL
                </span>

            </div>

            <div class="header-right">

                <a href="Notifications.aspx"
                    class="notification"
                    style="text-decoration: none;">

                    <i class="fas fa-bell"></i>

                    <span class="notify-count">1
                    </span>

                </a>

                <div class="user-info">

                    <i class="fas fa-user-circle"></i>

                    <div>

                        <div class="user-name">
                            <asp:Label ID="lblTrainerName" runat="server" Text="Trainer" />
                        </div>
                        <asp:Label ID="lblDesignation"
                            runat="server" />

                        <div class="date-time">

                            <span id="currentDate"></span>

                            |

                            <span id="currentTime"></span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- =========================
             MAIN LAYOUT
        ========================== -->

        <div class="main-layout">

            <!-- =========================
                 LEFT SIDEBAR
            ========================== -->

            <div class="sidebar" id="trainerSidebar">

                <!-- ================= DASHBOARD ================= -->

                <a href="Default.aspx"
                    class="menu-item">

                    <i class="fas fa-home mr-2"></i>
                    Dashboard

                </a>


                <!-- ================= MY SESSIONS ================= -->

                <div class="menu-heading collapsed"
                    onclick="toggleMenu('sessionMenu',this)">

                    <i class="fas fa-calendar-alt mr-2"></i>
                    My Sessions

                </div>

                <div id="sessionMenu"
                    class="submenu-container hide">

                   <%-- <a href="MySessions.aspx"
                        class="submenu-item">

                        <i class="fas fa-list mr-2"></i>
                        My Sessions

                    </a>--%>

                    <a href="SessionDetails.aspx"
                        class="submenu-item">

                        <i class="fas fa-info-circle mr-2"></i>
                        Session Details

                    </a>

                    <a href="SessionAttendance.aspx"
                        class="submenu-item">

                        <i class="fas fa-user-check mr-2"></i>
                        Session Attendance

                    </a>

                    <%--<a href="Attendance.aspx"
                        class="submenu-item">

                        <i class="fas fa-clipboard-check mr-2"></i>
                        Attendance

                    </a>--%>

                </div>


                <!-- ================= MATERIALS ================= -->

                <div class="menu-heading collapsed"
                    onclick="toggleMenu('materialMenu',this)">

                    <i class="fas fa-book mr-2"></i>
                    Training Materials

                </div>

                <div id="materialMenu"
                    class="submenu-container hide">

                   <%-- <a href="SessionMaterials.aspx"
                        class="submenu-item">

                        <i class="fas fa-file-alt mr-2"></i>
                        Session Materials

                    </a>--%>

                    <a href="TrainingMaterial.aspx"
                        class="submenu-item">

                        <i class="fas fa-book-open mr-2"></i>
                        Training Materials

                    </a>

                </div>


                <!-- ================= QUESTION BANK ================= -->

                <div class="menu-heading collapsed"
                    onclick="toggleMenu('questionMenu',this)">

                    <i class="fas fa-question-circle mr-2"></i>
                    Question Bank

                </div>

                <div id="questionMenu"
                    class="submenu-container hide">

                    <a href="QuestionBank.aspx"
                        class="submenu-item">

                        <i class="fas fa-list-alt mr-2"></i>
                        Question Bank

                    </a>

                    <a href="QuestionBankUpload.aspx"
                        class="submenu-item">

                        <i class="fas fa-file-excel mr-2"></i>
                        Question Bank Upload

                    </a>

                </div>


                <!-- ================= TESTS ================= -->

                <div class="menu-heading collapsed"
                    onclick="toggleMenu('testMenu',this)">

                    <i class="fas fa-file-alt mr-2"></i>
                    Tests &amp; Exams

                </div>

                <div id="testMenu"
                    class="submenu-container hide">

                    <%--<a href="TestMaster.aspx"
                        class="submenu-item">

                        <i class="fas fa-cogs mr-2"></i>
                        Test Master

                    </a>--%>

<%--                    <a href="TestDetails.aspx"
                        class="submenu-item">

                        <i class="fas fa-info-circle mr-2"></i>
                        Test Details

                    </a>--%>

                    <a href="PreTrainingTest.aspx"
                        class="submenu-item">

                        <i class="fas fa-edit mr-2"></i>
                        Pre Training Test

                    </a>

                    <a href="PostTrainingTest.aspx"
                        class="submenu-item">

                        <i class="fas fa-edit mr-2"></i>
                        Post Training Test

                    </a>

                    <a href="TestResult.aspx"
                        class="submenu-item">

                        <i class="fas fa-poll mr-2"></i>
                        Test Results

                    </a>

                    <a href="AnswerDetails.aspx"
                        class="submenu-item">

                        <i class="fas fa-check-square mr-2"></i>
                        Answer Details

                    </a>

                </div>


                <!-- ================= FEEDBACK ================= -->

                <div class="menu-heading collapsed"
                    onclick="toggleMenu('feedbackMenu',this)">

                    <i class="fas fa-comment-dots mr-2"></i>
                    Feedback

                </div>

                <div id="feedbackMenu"
                    class="submenu-container hide">

                   <%-- <a href="SessionFeedback.aspx"
                        class="submenu-item">

                        <i class="fas fa-star mr-2"></i>
                        Session Feedback

                    </a>--%>

                    <a href="FeedbackReport.aspx"
                        class="submenu-item">

                        <i class="fas fa-chart-bar mr-2"></i>
                        Feedback Report

                    </a>

                </div>


                <!-- ================= REPORTS ================= -->

                <div class="menu-heading collapsed"
                    onclick="toggleMenu('reportMenu',this)">

                    <i class="fas fa-chart-line mr-2"></i>
                    Reports

                </div>

                <div id="reportMenu"
                    class="submenu-container hide">

                    <a href="ExamResultReport.aspx"
                        class="submenu-item">

                        <i class="fas fa-poll-h mr-2"></i>
                        Exam Result Report

                    </a>

                    <a href="AttendanceReport.aspx"
                        class="submenu-item">

                        <i class="fas fa-clipboard-list mr-2"></i>
                        Attendance Report

                    </a>

                    <a href="TraineeProgress.aspx"
                        class="submenu-item">

                        <i class="fas fa-tasks mr-2"></i>
                        Trainee Progress

                    </a>

                    <a href="TrainingCalendar.aspx"
                        class="submenu-item">

                        <i class="fas fa-calendar mr-2"></i>
                        Training Calendar

                    </a>

                </div>


                <!-- ================= COMMUNICATION ================= -->

                <div class="menu-heading collapsed"
                    onclick="toggleMenu('communicationMenu',this)">

                    <i class="fas fa-bullhorn mr-2"></i>
                    Communication

                </div>

                <div id="communicationMenu"
                    class="submenu-container hide">

                    <a href="Announcement.aspx"
                        class="submenu-item">

                        <i class="fas fa-bullhorn mr-2"></i>
                        Announcements

                    </a>

                    <a href="Notifications.aspx"
                        class="submenu-item">

                        <i class="fas fa-bell mr-2"></i>
                        Notifications

                    </a>

                </div>


                <!-- ================= MY ACCOUNT ================= -->

                <div class="menu-heading collapsed"
                    onclick="toggleMenu('accountMenu',this)">

                    <i class="fas fa-user-cog mr-2"></i>
                    My Account

                </div>

                <div id="accountMenu"
                    class="submenu-container hide">

                    <a href="Profile.aspx"
                        class="submenu-item">

                        <i class="fas fa-user mr-2"></i>
                        Profile

                    </a>

                    <a href="ChangePassword.aspx"
                        class="submenu-item">

                        <i class="fas fa-key mr-2"></i>
                        Change Password

                    </a>

                </div>


                <!-- ================= LOGOUT ================= -->

                <a href="Logout.aspx"
                    class="menu-item logout-btn">

                    <i class="fas fa-sign-out-alt mr-2"></i>
                    Logout

                </a>

            </div>

            <!-- =========================
                 CONTENT AREA
            ========================== -->

            <div class="content-area">

                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>

            </div>

        </div>

        <!-- =========================
             FOOTER
        ========================== -->

        <div class="footer">

            <div>

                <a href="https://sbpdcl.co.in/" target="_blank">
                    <img src='<%= ResolveUrl("~/img/SBPDCL.png") %>' />
                </a>

                <a href="https://nbpdcl.co.in/" target="_blank">
                    <img src='<%= ResolveUrl("~/img/NBPDCL.png") %>' />
                </a>

                <a href="https://bsphcl.co.in/" target="_blank">
                    <img src='<%= ResolveUrl("~/img/BSPHCL_Footer.jpg") %>' />
                </a>

                <a href="https://www.bsptcl.in/" target="_blank">
                    <img src='<%= ResolveUrl("~/img/BSPTCL.png") %>' />
                </a>

                <a href="https://bspgcl.bihar.gov.in/" target="_blank">
                    <img src='<%= ResolveUrl("~/img/BSPGCL.png") %>' />
                </a>

            </div>

            <br />

            <div>

                <span class="footer-text">© <%: DateTime.Now.Year %> Training Cell BSPHCL</span>

                . All Rights Reserved.

                <br />

                Designed & Developed by

                <span class="footer-text">Training Cell, BSPHCL</span>

            </div>

        </div>

    </form>

    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>
        function updateDateTime() {
            var now = new Date();
            document.getElementById("currentDate").innerHTML = now.toLocaleDateString("en-GB");
            document.getElementById("currentTime").innerHTML = now.toLocaleTimeString();
        }
        updateDateTime();
        setInterval(updateDateTime, 1000);
    </script>

    <script>
        function toggleSidebar() {

            var sidebar =
                document.getElementById("trainerSidebar");

            sidebar.classList.toggle("collapsed");

            localStorage.setItem(
                "TrainerSidebar",
                sidebar.classList.contains("collapsed")
                    ? "Hide"
                    : "Show"
            );
        }

        document.addEventListener("DOMContentLoaded", function () {

            if (
                localStorage.getItem("TrainerSidebar")
                ==
                "Hide"
            ) {
                document
                    .getElementById("trainerSidebar")
                    .classList
                    .add("collapsed");
            }


            document
                .querySelectorAll(".submenu-container")
                .forEach(function (menu) {

                    if (
                        localStorage.getItem(menu.id)
                        ==
                        "open"
                    ) {
                        menu.classList.remove("hide");

                        var heading =
                            menu.previousElementSibling;

                        if (heading) {
                            heading.classList.remove("collapsed");
                        }
                    }
                });


            var currentPage =
                window.location.pathname
                    .split("/")
                    .pop()
                    .toLowerCase();


            document
                .querySelectorAll(".submenu-item, .menu-item")
                .forEach(function (link) {

                    var href =
                        link.getAttribute("href");

                    if (
                        href
                        &&
                        href.toLowerCase()
                        ==
                        currentPage
                    ) {
                        link.classList.add("active-menu");

                        var parentMenu =
                            link.closest(".submenu-container");

                        if (parentMenu) {

                            parentMenu.classList.remove("hide");

                            var heading =
                                parentMenu.previousElementSibling;

                            if (heading) {
                                heading.classList.remove("collapsed");
                            }

                            localStorage.setItem(
                                parentMenu.id,
                                "open"
                            );
                        }
                    }
                });
        });
    </script>

    <script>
        function toggleMenu(menuId, heading) {
            var menu = document.getElementById(menuId);
            menu.classList.toggle("hide");
            heading.classList.toggle("collapsed");
            localStorage.setItem(menuId, menu.classList.contains("hide") ? "" : "open");
        }
    </script>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src='<%= ResolveUrl("~/lib/easing/easing.min.js") %>'></script>
    <script src='<%= ResolveUrl("~/lib/owlcarousel/owl.carousel.min.js") %>'></script>
    <script src='<%= ResolveUrl("~/lib/isotope/isotope.pkgd.min.js") %>'></script>
    <script src='<%= ResolveUrl("~/lib/lightbox/js/lightbox.min.js") %>'></script>
    <script src='<%= ResolveUrl("~/mail/jqBootstrapValidation.min.js") %>'></script>
    <script src='<%= ResolveUrl("~/mail/contact.js") %>'></script>
    <script src='<%= ResolveUrl("~/js/main.js") %>'></script>

</body>

</html>
