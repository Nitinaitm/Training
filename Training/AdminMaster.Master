<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdminMaster.Master.cs" Inherits="Training.AdminMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>BSPHCL Training Management System</title>

    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="keywords" />
    <meta content="" name="description" />

    <!-- Favicon -->
    <link href='<%= ResolveUrl("~/img/BSPHCL_Logo.jpg") %>' rel="icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Handlee&family=Nunito:wght@400;600;700&display=swap"
        rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css"
        rel="stylesheet" />

    <!-- Bootstrap / Existing CSS -->
    <%--<link href="../css/style.css" rel="stylesheet" />--%>
    <link href='<%= ResolveUrl("~/css/style.css") %>'
        rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nunito',sans-serif;
            background: #f5f7fb;
        }

        /* =========================
   TOP HEADER
========================= */

        .top-header {
            height: 75px;
            background: #fff;
            border-bottom: 1px solid #dcdcdc;
            display: flex;
            align-items: center;
            padding: 0 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            position: sticky;
            top: 0;
            z-index: 9999;
            justify-content: space-between;
            align-items: center;
        }

        .header-logo {
            height: 55px;
            width: auto;
            margin-right: 15px;
        }

        .header-title {
            font-size: 30px;
            font-weight: 700;
            color: #0d6efd;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .notification {
            position: relative;
            font-size: 24px;
            color: #555;
            cursor: pointer;
        }

            .notification:hover {
                color: #0d6efd;
            }

        .notify-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background: red;
            color: white;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            font-size: 11px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .user-info i {
                font-size: 38px;
                color: #0d6efd;
            }

        .user-name {
            font-size: 16px;
            font-weight: bold;
        }

        .date-time {
            font-size: 12px;
            color: #666;
        }
        /* =========================
   MAIN LAYOUT
========================= */

        .main-layout {
            display: flex;
            min-height: calc(100vh - 75px);
        }

        /* =========================
   SIDEBAR
========================= */

        .sidebar {
            width: 260px;
            background: #1f2937;
            color: #fff;
            flex-shrink: 0;
            position: sticky;
            top: 75px;
            height: calc(100vh - 75px);
            overflow-y: auto;
            transition: all .3s ease;
        }

            .sidebar.collapsed {
                width: 0;
                min-width: 0;
                overflow: hidden;
            }

            .sidebar::-webkit-scrollbar {
                width: 8px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: #4b5563;
                border-radius: 20px;
            }

        /* Parent Menu */

        .menu-heading {
            background: #111827;
            color: #ffd54f;
            font-size: 15px;
            font-weight: 700;
            padding: 14px 18px;
            border-top: 1px solid #374151;
            border-bottom: 1px solid #374151;
            cursor: pointer;
            position: relative;
            transition: .3s;
        }

            .menu-heading:hover {
                background: #1e293b;
            }

            .menu-heading:after {
                content: '▼';
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 12px;
            }

            .menu-heading.collapsed:after {
                content: '▶';
            }

        /* Sub Menu */

        .submenu-container {
            display: block;
        }

            .submenu-container.hide {
                display: none;
            }

        .menu-item,
        .submenu-item {
            display: block;
            color: #fff;
            text-decoration: none;
            padding: 12px 18px;
            border-bottom: 1px solid #374151;
            transition: .3s;
        }

        .submenu-item {
            padding-left: 35px;
            background: #273449;
        }

            .menu-item:hover,
            .submenu-item:hover {
                background: #2563eb;
                color: #fff;
                text-decoration: none;
            }

        /* Active Page */

        .active-menu {
            background: #2563eb !important;
            color: #fff !important;
            font-weight: 700;
            border-left: 4px solid #ffd54f;
        }

        .active-parent {
            background: #172554 !important;
            color: #ffd54f !important;
        }

        /* Logout */

        .logout-btn {
            background: #dc2626;
            font-weight: 700;
        }

            .logout-btn:hover {
                background: #b91c1c;
            }

        /* =========================
   CONTENT AREA
========================= */

        .content-area {
            flex: 1;
            min-width: 0;
            padding: 20px;
            overflow-x: auto;
            background: #f8fafc;
            transition: all .3s ease;
        }

        .sidebar .submenu-container .menu-heading {
            background: #273449;
            padding-left: 35px;
            font-size: 14px;
            border-bottom: 1px solid #374151;
        }

        .sidebar .submenu-container .submenu-container .submenu-item {
            padding-left: 55px;
            background: #32435c;
        }

        .toggle-btn {
            font-size: 28px;
            color: #0d6efd;
            cursor: pointer;
            margin-right: 18px;
            user-select: none;
        }

            .toggle-btn:hover {
                color: #ff9800;
            }
        /* =========================
   MOBILE
========================= */

        @media(max-width:900px) {

            .top-header {
                height: auto;
                min-height: 65px;
                padding: 8px 10px;
                flex-wrap: wrap;
                gap: 8px;
            }

                .top-header > div:first-child {
                    flex: 1;
                    min-width: 0;
                }

            .toggle-btn {
                font-size: 24px;
                margin-right: 10px;
            }

            .header-logo {
                height: 38px;
                margin-right: 8px;
            }

            .header-title {
                font-size: 15px;
                line-height: 18px;
            }

            .header-right {
                gap: 12px;
                margin-left: auto;
            }

            .notification {
                font-size: 20px;
            }

            .user-info {
                gap: 6px;
            }

                .user-info i {
                    font-size: 28px;
                }

            .user-name {
                font-size: 13px;
            }

            .date-time {
                font-size: 10px;
            }

            .main-layout {
                flex-direction: column;
                min-height: auto;
            }

            .sidebar {
                width: 100%;
                height: auto;
                max-height: none;
                position: relative;
                top: 0;
            }

                .sidebar.collapsed {
                    display: none;
                    width: 100%;
                }

            .content-area {
                width: 100%;
                padding: 10px;
                overflow-x: auto;
            }

            .menu-heading,
            .menu-item,
            .submenu-item {
                font-size: 14px;
            }
        }


        @media(max-width:576px) {

            .top-header {
                align-items: center;
            }

            .header-title {
                font-size: 13px;
            }

            .header-logo {
                height: 34px;
            }

            .header-right {
                width: 100%;
                justify-content: flex-end;
                border-top: 1px solid #eee;
                padding-top: 5px;
            }

            .user-info i {
                font-size: 25px;
            }

            .content-area {
                padding: 7px;
            }

            .submenu-item {
                padding-left: 28px;
            }

            .sidebar .submenu-container .menu-heading {
                padding-left: 28px;
            }

            .sidebar .submenu-container .submenu-container .submenu-item {
                padding-left: 45px;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>

